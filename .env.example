# Vertex AI: use your own Google Cloud project and ADC authentication.
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Optional, for the standalone Gemini Developer API scripts.
GOOGLE_API_KEY=
# Safe defaults: no live orders.
AUTO_TRADING_DRY_RUN=true
AUTO_TRADING_CONFIRM_LIVE=NO
AUTO_TRADING_USE_LLM=true
AUTO_TRADING_SYMBOL=ETH/KRW
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
